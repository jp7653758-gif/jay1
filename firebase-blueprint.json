{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Private user account synced from Google ID or Google Phone OTP authentication.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Optional verified Google account email.",
          "maxLength": 320
        },
        "phoneNumber": {
          "type": "string",
          "description": "Optional verified E.164 phone number from Google Phone OTP.",
          "maxLength": 32
        },
        "displayName": {
          "type": "string",
          "description": "Display name shown in Account & Wallet sheet.",
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "description": "Optional Google avatar URL.",
          "maxLength": 500
        },
        "preferredCurrency": {
          "type": "string",
          "enum": ["INR", "USD"],
          "description": "Preferred checkout currency (INR for India Razorpay, USD for Stripe)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["uid", "displayName", "preferredCurrency", "createdAt", "updatedAt"]
    },
    "PaymentMethodRecord": {
      "title": "Saved Payment Method",
      "description": "Owner-scoped saved payment method (UPI, Card, NetBanking, or Wallet) for fast checkout.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Payment method document ID.",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "label": {
          "type": "string",
          "description": "Human-friendly label (e.g. Personal GPay UPI, HDFC Visa).",
          "minLength": 1,
          "maxLength": 60
        },
        "region": {
          "type": "string",
          "enum": ["IN", "GLOBAL"],
          "description": "Checkout billing region."
        },
        "gateway": {
          "type": "string",
          "enum": ["razorpay", "stripe"],
          "description": "Processor gateway."
        },
        "method": {
          "type": "string",
          "enum": ["upi", "card", "netbanking", "wallet"],
          "description": "Payment instrument type."
        },
        "detail": {
          "type": "string",
          "description": "Masked detail or handle (e.g. handle@okaxis or Visa •••• 4242).",
          "minLength": 2,
          "maxLength": 120
        },
        "isDefault": {
          "type": "boolean",
          "description": "Whether this method is selected by default on checkout."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "ownerUid",
        "label",
        "region",
        "gateway",
        "method",
        "detail",
        "isDefault",
        "createdAt",
        "updatedAt"
      ]
    },
    "TransferHistoryRecord": {
      "title": "Transfer History Record",
      "description": "Persisted transfer record showing file size, destination, payment method, and cost.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Short share code for the transfer.",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "headline": {
          "type": "string",
          "description": "Summary filename headline.",
          "minLength": 1,
          "maxLength": 180
        },
        "fileCount": {
          "type": "integer",
          "description": "Number of files in the transfer."
        },
        "totalBytes": {
          "type": "number",
          "description": "Total raw byte size across all files."
        },
        "billedGb": {
          "type": "integer",
          "description": "Rounded-up billable gigabytes (minimum 1 GB)."
        },
        "mode": {
          "type": "string",
          "enum": ["p2p", "server"],
          "description": "Transfer delivery mode."
        },
        "destination": {
          "type": "string",
          "description": "Destination label.",
          "minLength": 1,
          "maxLength": 180
        },
        "currency": {
          "type": "string",
          "enum": ["INR", "USD"],
          "description": "Billing currency."
        },
        "priceAmount": {
          "type": "number",
          "description": "Numeric billed cost."
        },
        "priceFormatted": {
          "type": "string",
          "description": "Formatted cost display string.",
          "minLength": 1,
          "maxLength": 32
        },
        "paymentGateway": {
          "type": "string",
          "enum": ["razorpay", "stripe"],
          "description": "Payment processor."
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["upi", "card", "netbanking", "wallet"],
          "description": "Payment instrument."
        },
        "payerRole": {
          "type": "string",
          "enum": ["sender", "receiver"],
          "description": "Whether sender pays upfront or asks receiver to pay."
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["paid", "pending_receiver"],
          "description": "Payment settlement state."
        },
        "status": {
          "type": "string",
          "enum": ["ready", "uploading", "streaming", "delivered", "deleted"],
          "description": "Lifecycle status of the transfer."
        },
        "shareUrl": {
          "type": "string",
          "description": "Shareable transfer link.",
          "minLength": 1,
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "code",
        "ownerUid",
        "headline",
        "fileCount",
        "totalBytes",
        "billedGb",
        "mode",
        "destination",
        "currency",
        "priceAmount",
        "priceFormatted",
        "paymentGateway",
        "paymentMethod",
        "payerRole",
        "paymentStatus",
        "status",
        "shareUrl",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profile containing verified Google email or Phone OTP number and currency preference."
    },
    "/users/{userId}/paymentMethods/{methodId}": {
      "schema": { "$ref": "#/entities/PaymentMethodRecord" },
      "description": "Owner-scoped saved checkout payment methods (UPI, Card, NetBanking, Wallet)."
    },
    "/users/{userId}/transfers/{transferCode}": {
      "schema": { "$ref": "#/entities/TransferHistoryRecord" },
      "description": "Owner-scoped Transfer History records storing file size, destination, payment gateway/method, and cost."
    }
  }
}

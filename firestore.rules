rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        (request.auth.token.firebase.sign_in_provider == 'phone' &&
         request.auth.token.phone_number is string &&
         request.auth.token.phone_number.size() >= 6)
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'preferredCurrency',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'email',
        'phoneNumber',
        'displayName',
        'photoURL',
        'preferredCurrency',
        'createdAt',
        'updatedAt'
      ]) &&
      ('email' in data || 'phoneNumber' in data) &&
      isValidId(data.uid) &&
      data.uid == userId &&
      data.uid == request.auth.uid &&
      (!('email' in data) || (data.email is string && data.email.size() >= 3 && data.email.size() <= 320)) &&
      (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() >= 6 && data.phoneNumber.size() <= 32)) &&
      data.displayName is string &&
      data.displayName.size() >= 1 &&
      data.displayName.size() <= 120 &&
      (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
      data.preferredCurrency in ['INR', 'USD'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPaymentMethod(data, userId, methodId) {
      return data.keys().hasAll([
        'id',
        'ownerUid',
        'label',
        'region',
        'gateway',
        'method',
        'detail',
        'isDefault',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'ownerUid',
        'label',
        'region',
        'gateway',
        'method',
        'detail',
        'isDefault',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.id) &&
      data.id == methodId &&
      data.id.size() >= 4 &&
      data.id.size() <= 64 &&
      isValidId(data.ownerUid) &&
      data.ownerUid == userId &&
      data.ownerUid == request.auth.uid &&
      data.label is string &&
      data.label.size() >= 1 &&
      data.label.size() <= 60 &&
      data.region in ['IN', 'GLOBAL'] &&
      data.gateway in ['razorpay', 'stripe'] &&
      data.method in ['upi', 'card', 'netbanking', 'wallet'] &&
      data.detail is string &&
      data.detail.size() >= 2 &&
      data.detail.size() <= 120 &&
      data.isDefault is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidTransferHistory(data, userId, transferCode) {
      return data.keys().hasAll([
        'code',
        'ownerUid',
        'headline',
        'fileCount',
        'totalBytes',
        'billedGb',
        'mode',
        'destination',
        'currency',
        'priceAmount',
        'priceFormatted',
        'paymentGateway',
        'paymentMethod',
        'payerRole',
        'paymentStatus',
        'status',
        'shareUrl',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'code',
        'ownerUid',
        'headline',
        'fileCount',
        'totalBytes',
        'billedGb',
        'mode',
        'destination',
        'currency',
        'priceAmount',
        'priceFormatted',
        'paymentGateway',
        'paymentMethod',
        'payerRole',
        'paymentStatus',
        'status',
        'shareUrl',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.code) &&
      data.code == transferCode &&
      data.code.size() >= 4 &&
      data.code.size() <= 32 &&
      isValidId(data.ownerUid) &&
      data.ownerUid == userId &&
      data.ownerUid == request.auth.uid &&
      data.headline is string &&
      data.headline.size() >= 1 &&
      data.headline.size() <= 180 &&
      data.fileCount is int &&
      data.fileCount >= 1 &&
      data.fileCount <= 100000 &&
      data.totalBytes is number &&
      data.totalBytes >= 0 &&
      data.billedGb is int &&
      data.billedGb >= 1 &&
      data.billedGb <= 25000 &&
      data.mode in ['p2p', 'server'] &&
      data.destination is string &&
      data.destination.size() >= 1 &&
      data.destination.size() <= 180 &&
      data.currency in ['INR', 'USD'] &&
      data.priceAmount is number &&
      data.priceAmount >= 0 &&
      data.priceAmount <= 10000000 &&
      data.priceFormatted is string &&
      data.priceFormatted.size() >= 1 &&
      data.priceFormatted.size() <= 32 &&
      data.paymentGateway in ['razorpay', 'stripe'] &&
      data.paymentMethod in ['upi', 'card', 'netbanking', 'wallet'] &&
      data.payerRole in ['sender', 'receiver'] &&
      data.paymentStatus in ['paid', 'pending_receiver'] &&
      data.status in ['ready', 'uploading', 'streaming', 'delivered', 'deleted'] &&
      data.shareUrl is string &&
      data.shareUrl.size() >= 1 &&
      data.shareUrl.size() <= 240 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'email',
          'phoneNumber',
          'displayName',
          'photoURL',
          'preferredCurrency',
          'updatedAt'
        ]);

      allow delete: if false;

      match /paymentMethods/{methodId} {
        allow get: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(methodId) &&
          isOwner(userId) &&
          existing().ownerUid == request.auth.uid;

        allow list: if isSignedIn() &&
          isOwner(userId) &&
          resource.data.ownerUid == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(methodId) &&
          isOwner(userId) &&
          isValidPaymentMethod(incoming(), userId, methodId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(methodId) &&
          isOwner(userId) &&
          isValidPaymentMethod(incoming(), userId, methodId) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().id == existing().id &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'isDefault',
            'label',
            'detail',
            'updatedAt'
          ]) &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow delete: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(methodId) &&
          isOwner(userId) &&
          existing().ownerUid == request.auth.uid &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
      }

      match /transfers/{transferCode} {
        allow get: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(transferCode) &&
          isOwner(userId) &&
          existing().ownerUid == request.auth.uid;

        allow list: if isSignedIn() &&
          isOwner(userId) &&
          resource.data.ownerUid == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(transferCode) &&
          isOwner(userId) &&
          isValidTransferHistory(incoming(), userId, transferCode) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(transferCode) &&
          isOwner(userId) &&
          isValidTransferHistory(incoming(), userId, transferCode) &&
          existing().status != 'deleted' &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().code == existing().code &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['paymentStatus', 'paymentGateway', 'paymentMethod', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['destination', 'updatedAt'])
          ) &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow delete: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(transferCode) &&
          isOwner(userId) &&
          existing().ownerUid == request.auth.uid &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
      }
    }
  }
}
